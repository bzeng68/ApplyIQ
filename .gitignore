# Per-profile personal data (gitignored — synced to GCS via sync-to-gcs.mjs)
profiles/

# Personal data (user fills these)
cv.md
data/applications.md
data/pipeline.md
data/evaluations.md
data/scan-history.tsv
reports/*.md
reports/*.json
!reports/.gitkeep
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv
batch/tracker-additions/**/*.tsv
!batch/tracker-additions/.gitkeep
jds/*
!jds/.gitkeep

# Writing samples (user's personal files — never committed)
writing-samples/*
!writing-samples/README.md

# User config and customization (never auto-updated)
config/profile.yml
portals.yml
modes/_profile.md
.update-dismissed
.update-lock

# Secrets (never commit — use .env.example as template)
.env
.gcp/

# Generated
.resolved-prompt-*
node_modules/
dashboard-web/.next/
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/terraform.tfvars
bun.lock

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.claude/memory/
career-dashboard

# Local generated data (populated by pipeline at runtime)
data/dashboard-offers.json
data/ui-state.json
data/jds/