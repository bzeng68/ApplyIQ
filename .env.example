# ApplyIQ — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── GCS Sync ─────────────────────────────────────────────────────────────────
# Required for: local data to propagate to the cloud dashboard.
# After running `node build-dashboard-data.mjs` locally, data/ + reports/ + batch/
# are pushed to this bucket so the live dashboard stays up to date.
#
# Find your bucket name: gcloud storage buckets list --project=apply-iq-495519
# Auth (one-time):       gcloud auth application-default login
GCS_BUCKET=applyiq-data-apply-iq-495519

# ── Anthropic API (batch evaluation) ─────────────────────────────────────────
# Required for: node scripts/evaluate-new.mjs (Playwright batch evaluator)
# Get your key: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-api03-...
